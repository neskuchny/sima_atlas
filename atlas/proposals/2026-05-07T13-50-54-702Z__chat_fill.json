  "new_block_proposals": [
    {
      "id": "b.canvas-engine",
      "title": "Canvas Artefact Engine",
      "layer": "logic",
      "mission": "Этот блок отвечает за управление визуальными элементами на рабочем пространстве (канвасе). Он обеспечивает создание, хранение и связывание различных типов артефактов, таких как встречи, документы, схемы и текстовые заметки. Система поддерживает создание иерархических структур, позволяя вкладывать одни карты в другие. Блок обеспечивает целостность связей между источниками данных и производными сущностями. Это позволяет пользователю визуализировать происхождение информации и логику построения продукта.",
      "kpi": [
        "Среднее время отклика на создание связи < 100мс",
        "Поддержка до 1000 узлов на одном канвасе без потери производительности"
      ],
      "acceptance": [],
      "depends_on_capabilities": [],
      "provides_capabilities": [
        "artefact_management",
        "link_graph_engine",
        "nested_canvas_support"
      ],
      "rationale": "Необходим для реализации визуального управления контекстом и связями между разрозненными источниками информации."
    },
    {
      "id": "b.context-analyzer",
      "title": "Context Intelligence Service",
      "layer": "logic",
      "mission": "Сервис анализирует содержимое всех добавленных на канвас артефактов для формирования целостной картины продукта. Он автоматически выявляет недостающие элементы (например, отсутствие Job-to-be-Done) и подсвечивает пробелы в архитектуре. Блок интегрируется с LLM для генерации описаний, тегирования и редактирования миссии продукта. Он обеспечивает трансляцию неструктурированных данных из встреч и документов в формализованные требования для разработки.",
      "kpi": [
        "Точность выявления пробелов в требованиях > 90%",
        "Время генерации описания блока < 3с"
      ],
      "acceptance": [],
      "depends_on_capabilities": [],
      "provides_capabilities": [
        "automated_gap_analysis",
        "llm_content_refinement",
        "entity_tagging"
      ],
      "rationale": "Позволяет автоматизировать анализ контекста и помогать пользователю достраивать архитектуру продукта на основе имеющихся данных."
    },
    {
      "id": "b.canvas-ui",
      "title": "Canvas Visualization UI",
      "layer": "front",
      "mission": "Интерфейс для визуального взаимодействия с картой проекта, обеспечивающий навигацию по папкам, проектам и встречам. Он предоставляет инструменты для создания, редактирования и связывания блоков, а также отображение метаданных при клике на элементы. UI поддерживает отображение типов блоков через цветовую кодировку и визуализацию направленных связей. Пользователь получает возможность проваливаться вглубь вложенных схем через интуитивно понятное меню.",
      "kpi": [
