{
  "name": "sima-atlas",
  "version": "0.3.0",
  "private": false,
  "description": "Contract-first visual control plane between developers and AI coding agents (Claude Code / Cursor / Codex). Blocks live as directories with mission.md / kpi.md / acceptance.md; agents read contracts via MCP, write code, report to checks.log; Sima verifies each run against acceptance.",
  "license": "MIT",
  "homepage": "https://github.com/neskuchny/sima_atlas",
  "repository": {
    "type": "git",
    "url": "https://github.com/neskuchny/sima_atlas.git"
  },
  "bugs": "https://github.com/neskuchny/sima_atlas/issues",
  "keywords": [
    "ai-agents",
    "claude-code",
    "cursor",
    "codex",
    "mcp",
    "contract-first",
    "visual-programming",
    "ai-coding",
    "agent-orchestration"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev_server.mjs",
    "dev:nobrowser": "node scripts/dev_server.mjs --no-browser",
    "verify": "node scripts/verify_all.mjs",
    "test:e2e": "playwright test",
    "test:nightly": "node scripts/nightly_consolidation.mjs",
    "atlas:api": "node scripts/atlas_api_server.mjs",
    "ui:serve": "node scripts/dev_server.mjs --no-browser",
    "hero:capture": "node scripts/capture_hero_screenshot.mjs",
    "desktop:dev": "cd extensions/desktop && npm install && npm start",
    "desktop:pack": "cd extensions/desktop && npm install && npm run pack",
    "loop": "node scripts/agent_loop_daemon.mjs --dry-run",
    "loop:run": "node scripts/agent_loop_daemon.mjs",
    "loop:overnight": "node scripts/agent_loop_daemon.mjs --agent claude --max-iterations 8 --max-cost-usd 2.00 --consecutive-fail-limit 3"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}
