# LLM trace logs (operational, written on every gateway call)
atlas/llm_traces/*
!atlas/llm_traces/.gitkeep

# Eval history snapshots — only keep first/baseline + .gitkeep; runtime ones are noise.
atlas/eval_history/*
!atlas/eval_history/.gitkeep
!atlas/eval_history/baseline.json

# Acceptance verifier per-run snapshots — verifier overwrites _latest.json
# every run; per-timestamp files are historical and don't need to be in git.
# Keep _latest.json + _previous.json + _summary.json as those are the
# current state surfaces consumed by the UI / nightly.
atlas/acceptance_runs/**/2*.json
!atlas/acceptance_runs/**/_latest.json
!atlas/acceptance_runs/**/_previous.json
!atlas/acceptance_runs/**/_summary.json

# Context-pack regen artifacts — built from contracts on every nightly,
# zero source-of-truth value.
atlas/context_packs/*.json

# Operator profile history — per-operator interaction trace, may contain
# privacy-sensitive content from the operator's own sessions.
atlas/operator_profile/history/*
!atlas/operator_profile/history/.gitkeep

# Process-run traces (cursor observations etc.) — verbose runtime logs.
atlas/process_runs/**/*

# Pending UI proposals — runtime queue, not source of truth.
atlas/proposals/*
!atlas/proposals/.gitkeep
# Same runtime-queue rule for per-tenant proposals — they're ephemeral
# pending plans, not source of truth. UI consumes from
# atlas/clients/<id>/proposals/ when ?client=X is set in the URL.
atlas/clients/*/proposals/*
!atlas/clients/*/proposals/.gitkeep

# Per-run agent log files — written on every /runs/start.
atlas/run_logs/*
!atlas/run_logs/.gitkeep

# Run-state snapshots (FSM mid-flight); _summary surfaces the final outcome.
atlas/run_state/*.json
!atlas/run_state/_summary.json

# Chat watcher artefacts (Phase R-3) — local cursor maps full session
# paths under ~/.claude/projects, which leak session UUIDs and home path.
atlas/run_state/chat_watch_cursor.json
atlas/run_state/chat_watch_status.json

# Ingestion scratch space.
atlas/ingestion_scratch/*

# Activity log — append-only runtime trace.
atlas/activity_log.jsonl
atlas/transitions.log
atlas/ingestion_queue.jsonl

# Misc
node_modules/
.env
.env.local
*.log.bak
tests/playwright/_report/
tests/playwright/test-results/
test-results/

# V-1 autonomous loop reports — runtime, regenerated each run.
atlas/autonomous_runs/*
!atlas/autonomous_runs/.gitkeep
atlas/clients/*/autonomous_runs/*

# print-only mode prompt dumps — runtime.
atlas/agent_invocations/*
atlas/clients/*/agent_invocations/*

# S-7 change-sets — operator runtime records.
atlas/change_sets/*
!atlas/change_sets/.gitkeep
atlas/clients/*/change_sets/*

# R-7.94 semantic verdicts — runtime, regenerated by semantic_verify.
atlas/blocks/*/semantic_review.json
atlas/clients/*/blocks/*/semantic_review.json

# Internal launch / go-to-market material — never in the public repo.
marketing/
